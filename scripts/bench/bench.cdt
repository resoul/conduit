import * as fs from "cdt.fs"
import * as path from "cdt.path"
import * as process from "cdt.process"
import * as crypto from "cdt.crypto"
import * as json from "cdt.json"
import * as env from "cdt.env"
import * as time from "cdt.time"
import * as csv from "cdt.csv"
import * as url from "cdt.url"
import * as http from "cdt.http"
import * as jwt from "cdt.jwt"
import * as cache from "cdt.cache"

enum BenchEvent {
    Tick,
    Add(a: Int, b: Int),
    Scale(val: Int, factor: Int)
}

struct BenchClaim {
    sub: String
    uid: Int
}

func h_root(_req: http.Request) -> http.Response { return http.text("ok") }
func h_health(_req: http.Request) -> http.Response { return http.text("ok") }
func h_items(_req: http.Request) -> http.Response { return http.text("items") }
func h_orders(req: http.Request) -> http.Response {
    id := req.params.get("id") ?? ""
    return http.text(id)
}
func h_files(_req: http.Request) -> http.Response { return http.text("file") }
func h_echo(req: http.Request) -> http.Response { return http.json(req.body) }

router BenchApi {
    get "/" => h_root
    get "/health" => h_health
    get "/api/v1/items" => h_items
    get "/api/v1/users/:id/orders" => h_orders
    get "/files/*rest" => h_files
    post "/api/v1/echo" => h_echo
}

struct Item {
    id: Int
    user: String
    score: Int
}

func ms_since(t0: time.Instant) -> Float | time.TimeError {
    el := time.elapsed(t0)?
    ns := el.nanoseconds()?
    return ns.to_float() / 1000000.0
}

func vm_fib(n: Int) -> Int {
    if n < 2 {
        return n
    }
    return vm_fib(n - 1) + vm_fib(n - 2)
}

export func main() -> Void | KeyError | fs.FsError | process.ProcessError | crypto.CryptoError | json.DecodeError | json.EncodeError | time.TimeError | csv.CsvError | url.UrlError | jwt.JwtError | cache.CacheError {
    // ── 0. Pure-VM Computation ───────────────────────────────────────────────
    t_fib := time.monotonic()
    fib_res := vm_fib(35)
    ms_vm_fib := ms_since(t_fib)?
    if fib_res != 9227465 { return }

    t_arith := time.monotonic()
    var arith_acc = 0
    var li = 0
    while li < 10000000 {
        arith_acc = (arith_acc * 1664525 + 1013904223 + li) % 1000000007
        li = li + 1
    }
    ms_vm_arith := ms_since(t_arith)?
    if arith_acc < 0 { return }

    t_map := time.monotonic()
    vm_m := Map<Int, Int>()
    li = 0
    while li < 100000 {
        vm_m.set(li, li * 3 + 1)
        li = li + 1
    }
    var map_acc = 0
    li = 0
    while li < 100000 {
        map_acc = map_acc + (vm_m.get(li) ?? 0)
        li = li + 1
    }
    ms_vm_map := ms_since(t_map)?
    if map_acc < 0 { return }

    t_adt := time.monotonic()
    var adt_acc = 0
    li = 0
    while li < 1000000 {
        rem := li % 4
        var ev = BenchEvent.Tick
        if rem == 1 {
            ev = BenchEvent.Add(a: li, b: 7)
        } else if rem == 2 {
            ev = BenchEvent.Scale(val: li, factor: 3)
        } else if rem == 3 {
            ev = BenchEvent.Add(a: li, b: -2)
        }
        switch ev {
            case BenchEvent.Tick:
                adt_acc = adt_acc + 1
            case BenchEvent.Add(a, b):
                adt_acc = adt_acc + a + b
            case BenchEvent.Scale(v, f):
                adt_acc = adt_acc + v * f
        }
        li = li + 1
    }
    ms_adt := ms_since(t_adt)?
    if adt_acc != 625001500000 { return }
    // ── 1. FS I/O (100k lines / 5.53 MiB) ────────────────────────────────────
    cwd := process.cwd()?
    base := path.join(cwd, "_conduit_bench_tmp")
    fs.mkdir_all(base)?
    p := path.join(base, "data.txt")
    p_bulk := path.join(base, "bulk.txt")

    t_ws := time.monotonic()
    w := fs.open_write(p)?
    i := 0
    while i < 100000 {
        w.write_line("line payload number 0123456789 abcdefghijklmnopqrstuvwxyz")?
        i = i + 1
    }
    w.flush()?
    w.close()
    ms_write_stream := ms_since(t_ws)?

    data := fs.read_text(p)?
    // Warmup
    _w_r := fs.read_text(p)?

    t_wt := time.monotonic()
    fs.write_text(p_bulk, data)?
    ms_write_text := ms_since(t_wt)?

    t_rt := time.monotonic()
    rt := fs.read_text(p)?
    if rt.len() < 0 { return }
    ms_read_text := ms_since(t_rt)?

    t_rl := time.monotonic()
    rl := fs.read_lines(p)?
    if rl.len() < 0 { return }
    ms_read_lines := ms_since(t_rl)?

    t_el := time.monotonic()
    n_el := fs.each_line(p, (ln: String) => {
        if ln.len() < 0 { x := 0 }
    })?
    if n_el < 0 { return }
    ms_each_line := ms_since(t_el)?

    t_rc := time.monotonic()
    rc := fs.open_read(p)?
    while true {
        ch := rc.read_chunk(65536)
        switch ch {
            case nil:
                break
            case fs.FsError(e):
                rc.close()
                return e
            case String(s):
                if s.len() < 0 { break }
        }
    }
    rc.close()
    ms_read_chunk := ms_since(t_rc)?
    fs.remove(base)?

    // ── 2. Crypto, Path, Process ─────────────────────────────────────────────
    chunk := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    big := chunk
    i = 0
    while i < 14 {
        big = big + big
        i = i + 1
    }
    _w_sha := crypto.sha256(big)
    _w_b64 := crypto.base64_encode(big)

    t_sha := time.monotonic()
    i = 0
    while i < 50 {
        _h := crypto.sha256(big)
        i = i + 1
    }
    ms_sha := ms_since(t_sha)?

    t_be := time.monotonic()
    b64_s := ""
    i = 0
    while i < 50 {
        b64_s = crypto.base64_encode(big)
        i = i + 1
    }
    ms_b64e := ms_since(t_be)?

    t_bd := time.monotonic()
    i = 0
    while i < 50 {
        _d := crypto.base64_decode(b64_s)?
        i = i + 1
    }
    ms_b64d := ms_since(t_bd)?

    t_uu := time.monotonic()
    i = 0
    while i < 10000 {
        _u := crypto.uuid_v4()
        i = i + 1
    }
    ms_uuid := ms_since(t_uu)?

    t_pa := time.monotonic()
    i = 0
    while i < 100000 {
        _np := path.normalize(path.join("/var/log", "app/../service/output.log"))
        i = i + 1
    }
    ms_path := ms_since(t_pa)?

    is_win := false
    switch env.get("OS") {
        case String(os_val):
            if os_val == "Windows_NT" { is_win = true }
        case nil:
            is_win = false
    }
    proc_cmd := "true"
    proc_args := [""]
    proc_args = []
    if is_win {
        proc_cmd = "cmd"
        proc_args = ["/c", "exit", "0"]
    }
    t_pr := time.monotonic()
    i = 0
    while i < 50 {
        _po := process.run(proc_cmd, proc_args)?
        i = i + 1
    }
    ms_proc := ms_since(t_pr)?

    // ── 3. JSON + Pipeline (map / filter / reduce) ───────────────────────────
    items := [Item(id: 0, user: "u0", score: 0)]
    items = []
    i = 0
    while i < 10000 {
        items.append(Item(id: i, user: "alice_" + (i % 10).to_string(), score: i % 100))
        i = i + 1
    }

    t_je := time.monotonic()
    raw_json := json.encode(items)?
    ms_json_enc := ms_since(t_je)?

    t_jd := time.monotonic()
    decoded := json.decode<[Item]>(raw_json)?
    if decoded.len() < 0 { return }
    ms_json_dec := ms_since(t_jd)?

    nums := [0]
    nums = []
    i = 0
    while i < 1000000 {
        nums.append(i)
        i = i + 1
    }
    t_pl := time.monotonic()
    sum := nums
        |> filter((x: Int) => x % 2 == 0)
        |> map((x: Int) => x * 3 + 1)
        |> reduce(0, (acc: Int, x: Int) => acc + x)
    ms_pipe := ms_since(t_pl)?
    if sum < 0 { return }
    print("CHECK|" + sum.to_string())

    fnums := [0.0]
    fnums = []
    i = 0
    while i < 1000000 {
        fnums.append(i.to_float())
        i = i + 1
    }
    t_fpl := time.monotonic()
    fsum := fnums
        |> filter((x: Float) => x > 250000.0)
        |> map((x: Float) => x * 1.5 + 0.25)
        |> reduce(0.0, (acc: Float, x: Float) => acc + x)
    ms_fpipe := ms_since(t_fpl)?
    if fsum < 0.0 { return }

    csv_lines := ["id,name,note"]
    i = 0
    while i < 20000 {
        csv_lines.append("{i},\"user, #{i}\",\"ok \"\"v1\"\"\"")
        i = i + 1
    }
    csv_raw := csv_lines.join("\n")
    t_csv := time.monotonic()
    csv_rows := csv.parse(csv_raw)?
    ms_csv := ms_since(t_csv)?
    if csv_rows.len() < 0 { return }

    sample_url := "https://api.example.com:8443/v1/items?tag=prod&limit=50&offset=100#top"
    t_url := time.monotonic()
    i = 0
    url_acc := 0
    while i < 50000 {
        u := url.parse(sample_url)?
        q := url.decode_query(u.query)?
        url_acc = url_acc + q.len()
        i = i + 1
    }
    ms_url := ms_since(t_url)?
    if url_acc < 0 { return }

    router_obj := http.build<BenchApi>()
    empty_hdrs := Map<String, String>()
    req0 := http.Request(method: "GET", path: "/", body: "", headers: empty_hdrs, query: empty_hdrs, params: empty_hdrs)
    req1 := http.Request(method: "GET", path: "/health", body: "", headers: empty_hdrs, query: empty_hdrs, params: empty_hdrs)
    req2 := http.Request(method: "GET", path: "/api/v1/users/42/orders", body: "", headers: empty_hdrs, query: empty_hdrs, params: empty_hdrs)
    req3 := http.Request(method: "GET", path: "/files/docs/readme.md", body: "", headers: empty_hdrs, query: empty_hdrs, params: empty_hdrs)
    t_http := time.monotonic()
    i = 0
    http_acc := 0
    while i < 12500 {
        r0 := router_obj.dispatch(req0)
        r1 := router_obj.dispatch(req1)
        r2 := router_obj.dispatch(req2)
        r3 := router_obj.dispatch(req3)
        http_acc = http_acc + r0.status + r0.body.len() + r1.status + r1.body.len() + r2.status + r2.body.len() + r3.status + r3.body.len()
        i = i + 1
    }
    ms_http := ms_since(t_http)?
    if http_acc != 10125000 { return }

    jwt_secret := "conduit_bench_jwt_secret_key_32b"
    t_jwt := time.monotonic()
    i = 0
    var jwt_acc = 0
    while i < 10000 {
        tok := jwt.sign(BenchClaim(sub: "user", uid: i), jwt_secret)?
        cl := jwt.verify<BenchClaim>(tok, jwt_secret)?
        jwt_acc = jwt_acc + cl.uid
        i = i + 1
    }
    ms_jwt := ms_since(t_jwt)?
    if jwt_acc != 49995000 { return }

    lru := cache.open("bench_lru", 4096)
    lru.clear()?
    defer cache.drop("bench_lru")
    t_lru := time.monotonic()
    i = 0
    var cache_acc = 0
    while i < 100000 {
        k_set := "k" + (i % 8192).to_string()
        lru.set(k_set, "v")?
        k_get := "k" + ((i + 6144) % 8192).to_string()
        if lru.get(k_get) != nil {
            cache_acc = cache_acc + 1
        }
        i = i + 1
    }
    ms_cache := ms_since(t_lru)?
    if cache_acc != 97905 { return }

    print("BENCH|vm_fib_35|" + ms_vm_fib.to_string())
    print("BENCH|vm_arith_10m|" + ms_vm_arith.to_string())
    print("BENCH|vm_map_100k|" + ms_vm_map.to_string())
    print("BENCH|adt_switch_1m|" + ms_adt.to_string())

    print("BENCH|fs_write_text|" + ms_write_text.to_string())
    print("BENCH|fs_write_lines|" + ms_write_stream.to_string())
    print("BENCH|fs_read_text|" + ms_read_text.to_string())
    print("BENCH|fs_read_lines|" + ms_read_lines.to_string())
    print("BENCH|fs_each_line|" + ms_each_line.to_string())
    print("BENCH|fs_read_chunk64k|" + ms_read_chunk.to_string())
    print("BENCH|crypto_sha256_50m|" + ms_sha.to_string())
    print("BENCH|crypto_b64_enc_50m|" + ms_b64e.to_string())
    print("BENCH|crypto_b64_dec_50m|" + ms_b64d.to_string())
    print("BENCH|crypto_uuid_10k|" + ms_uuid.to_string())
    print("BENCH|path_join_norm_100k|" + ms_path.to_string())
    print("BENCH|process_run_50x|" + ms_proc.to_string())
    print("BENCH|json_encode_10k|" + ms_json_enc.to_string())
    print("BENCH|json_decode_10k|" + ms_json_dec.to_string())
    print("BENCH|pipeline_1m|" + ms_pipe.to_string())
    print("BENCH|pipeline_float_1m|" + ms_fpipe.to_string())
    print("BENCH|csv_parse_20k|" + ms_csv.to_string())
    print("BENCH|url_parse_50k|" + ms_url.to_string())
    print("BENCH|http_router_50k|" + ms_http.to_string())
    print("BENCH|jwt_hs256_10k|" + ms_jwt.to_string())
    print("BENCH|cache_lru_100k|" + ms_cache.to_string())
    return
}
