import * as http from "cdt.http"
import { EncodeError } from "cdt.json"
import * as validation from "cdt.validation"

@http.status(404)
error NotFoundError {
    message: String
}

@http.query
struct UserParams {
    id: String
}

@http.query
struct ListItemsQuery {
    page: Int = 1
    @validation.range(1, 50)
    limit: Int = 10
}

struct ItemPatch {
    id: String
    status: String
}

struct UserReply {
    user_id: String
}

struct ItemsPage {
    page: Int
    limit: Int
}

struct StatusReply {
    status: String
}

func check_admin_auth(req: http.Request) -> http.Response? {
    token := req.header("Authorization") ?? ""
    if token != "Bearer secret" {
        return http.response(401, "unauthorized")
    }
    return nil
}

func add_powered_by(_req: http.Request, resp: http.Response) -> http.Response {
    hdrs := resp.headers
    hdrs.set("x-powered-by", "conduit")
    return http.response_with(resp.status, resp.body, hdrs)
}

func home_handler(_req: http.Request) -> http.Response {
    return http.text("cdt-curl demo server")
}

func get_user_handler(_req: http.Request, q: UserParams) -> UserReply | NotFoundError {
    if q.id == "missing" {
        return NotFoundError(message: "user not found")
    }
    return UserReply(user_id: q.id)
}

func list_items_handler(_req: http.Request, q: ListItemsQuery) -> ItemsPage {
    return ItemsPage(page: q.page, limit: q.limit)
}

func echo_handler(req: http.Request) -> http.Response {
    return http.json(req.body)
}

func patch_item_handler(req: http.Request) -> http.Response {
    id := req.param("id") ?? "0"
    return http.ok_json(ItemPatch(id: id, status: "updated"))
}

func options_item_handler(_req: http.Request) -> http.Response {
    return http.no_content()
}

func health_handler(req: http.Request) -> http.Response {
    return http.text("ok:" + req.method)
}

func admin_stats_handler(_req: http.Request) -> http.Response {
    return http.ok_json(StatusReply(status: "ok"))
}

export router DemoApi "CdtCurl demo HTTP router" {
    cors "*"
    after add_powered_by
    get "/" => home_handler
    get "/users/:id" => get_user_handler
    get "/items" => list_items_handler
    post "/echo" => echo_handler
    patch "/items/:id" => patch_item_handler
    options "/items/:id" => options_item_handler
    any "/health" => health_handler
    group "/admin" {
        before check_admin_auth
        get "/stats" => admin_stats_handler
    }
}

export func build_demo_router() -> http.Router {
    r := http.build<DemoApi>()
    r.post("/shutdown", (_req: http.Request) -> http.Response => {
        r.stop()
        return http.text("shutting down")
    })
    return r
}

export func run_self_test() -> Void {
    r := build_demo_router()
    empty := Map<String, String>()

    r_home := r.dispatch(http.Request(method: "GET", path: "/", body: "", headers: empty, query: empty, params: empty))
    r_user := r.dispatch(http.Request(method: "GET", path: "/users/42", body: "", headers: empty, query: empty, params: empty))
    r_patch := r.dispatch(http.Request(method: "PATCH", path: "/items/9", body: "", headers: empty, query: empty, params: empty))
    r_unauth := r.dispatch(http.Request(method: "GET", path: "/admin/stats", body: "", headers: empty, query: empty, params: empty))
    r_auth := r.dispatch(http.Request(
        method: "GET",
        path: "/admin/stats",
        body: "",
        headers: Map.from([("Authorization", "Bearer secret")]),
        query: empty,
        params: empty,
    ))
    powered := r_auth.headers.get("x-powered-by") ?? ""
    cors_hdr := r_user.headers.get("access-control-allow-origin") ?? ""

    print("GET /: {r_home.status} -> {r_home.body}")
    print("GET /users/42: {r_user.status} -> {r_user.body} [cors={cors_hdr}]")
    print("PATCH /items/9: {r_patch.status} -> {r_patch.body}")
    print("GET /admin/stats (no auth): {r_unauth.status} -> {r_unauth.body}")
    print("GET /admin/stats (auth): {r_auth.status} -> {r_auth.body} [x-powered-by={powered}]")
}

export func serve_demo(addr: String) -> Void | http.HttpError {
    r := build_demo_router()
    print("Listening on http://{addr} (POST /shutdown to stop gracefully)")
    r.serve(addr)?
    print("Server stopped cleanly.")
    return
}
