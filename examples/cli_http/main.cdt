import cli from "cdt.cli"
import { CliError } from "cdt.cli"
import { EnvError } from "cdt.env"
import * as fs from "cdt.fs"
import * as http from "cdt.http"
import { DecodeError, EncodeError } from "cdt.json"
import { TimeError } from "cdt.time"
import * as url from "cdt.url"
import { ValidationError } from "cdt.validation"
import { CdtCurl } from "./cli"

func main() -> Void {
    switch cli.dispatch<CdtCurl>() {
        case CliError(e):
            print("CLI error [{e.kind}]: {e.message}")
        case EnvError(e):
            print("Env error: {e.message}")
        case fs.FsError(e):
            print("FS error [{e.kind}]: {e.message}")
        case http.HttpError(e):
            print("HTTP error [{e.kind}]: {e.message}")
        case url.UrlError(e):
            print("URL error [{e.kind}]: {e.message}")
        case ValidationError(e):
            print("Validation error ({e.violations.len()} violations)")
        case DecodeError(e):
            print("JSON decode error: {e.message}")
        case EncodeError(e):
            print("JSON encode error: {e.message}")
        case TimeError(e):
            print("Time error: {e.message}")
        case _:
            return
    }
}
