func process_order(user_id: Int, amount: Int) -> String {
    guard user_id > 0 else {
        return "Error: Invalid user ID"
    }

    guard amount > 0 else {
        return "Error: Amount must be greater than zero"
    }

    return "Order processed for user {user_id} with amount {amount}"
}

func get_port(custom_port: Int?) -> Int {
    return custom_port ?? 8080
}

func get_greeting(nickname: String?) -> String {
    name := nickname ?? "Anonymous Guest"
    return "Welcome, {name}!"
}

func main() {
    print("=== Testing guard statements ===")
    r1 := process_order(-1, 100)
    print(r1)

    r2 := process_order(42, 0)
    print(r2)

    r3 := process_order(42, 250)
    print(r3)

    print("=== Testing null-coalescing ?? operator ===")
    port1 := get_port(nil)
    print("Default port: {port1}")

    port2 := get_port(3000)
    print("Custom port: {port2}")

    g1 := get_greeting(nil)
    print(g1)

    g2 := get_greeting("Alice")
    print(g2)
}

