error DivisionByZero {}

func divide(a: Int, b: Int) -> (Int, Int) | DivisionByZero {
    guard b != 0 else {
        return DivisionByZero()
    }

    return (a / b, a % b)
}

func quotient(a: Int, b: Int) -> Int | DivisionByZero {
    // Destructuring with wildcard '_' and '?' operator propagation
    (val, _) := divide(a, b)?
    return val
}

func main() {
    print("=== Testing successful divide ===")
    res1 := divide(17, 5)
    switch res1 {
        case (q, r):
            print("Quotient: {q}, Remainder: {r}")
        case DivisionByZero(err):
            print("Cannot divide by zero")
    }

    print("=== Testing divide by zero ===")
    res2 := divide(42, 0)
    switch res2 {
        case (q, r):
            print("Quotient: {q}, Remainder: {r}")
        case DivisionByZero(err):
            print("Caught DivisionByZero successfully!")
    }

    print("=== Testing quotient helper with '?' ===")
    q1 := quotient(100, 7)
    switch q1 {
        case Int(val):
            print("100 / 7 quotient is {val}")
        case DivisionByZero(err):
            print("Division failed")
    }
}

