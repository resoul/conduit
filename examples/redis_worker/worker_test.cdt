import * as json from "cdt.json"
import * as redis from "cdt.redis"
import * as lock from "cdt.lock"
import * as validation from "cdt.validation"
import { Job, JobPayload, describe_payload, make_job, run_payload_workers } from "./main"

test "redis_worker Job validation accepts UUID and allowed kind" {
    job := make_job("webhook")?
    assert_eq(job.kind, "webhook")
    assert(job.created_at.ends_with("Z"))

    var bad_err = false
    switch validation.check(Job(id: "not-a-uuid", kind: "sms", created_at: " ")) {
        case validation.ValidationError(err):
            bad_err = err.issues.len() == 3
        case Job(_):
            bad_err = false
    }
    assert(bad_err)
}

test "redis_worker rejects invalid Redis URL cleanly" {
    var err_kind = ""
    switch redis.connect("http://127.0.0.1:6379") {
        case redis.RedisError(e):
            err_kind = e.kind
        case redis.Client(_):
            err_kind = "unexpected"
    }
    assert_eq(err_kind, "invalid_url")
}

test "redis_worker in-process lock guards batch step" {
    v := lock.with("worker:local", () => 100 + 23)?
    assert_eq(v, 123)
}

test "redis_worker JobPayload tagged union switch and JSON roundtrip" {
    p1 := JobPayload.Webhook(url: "https://example.com/hook")
    assert_eq(describe_payload(p1), "webhook->https://example.com/hook(retries=3)")

    raw := json.encode(p1)?
    assert(raw.contains("\"type\":\"Webhook\""))
    decoded := json.decode<JobPayload>(raw)?
    assert_eq(describe_payload(decoded), "webhook->https://example.com/hook(retries=3)")

    hb_raw := json.encode(JobPayload.Heartbeat)?
    hb := json.decode<JobPayload>(hb_raw)?
    assert_eq(describe_payload(hb), "heartbeat")
}

test "redis_worker channel worker pool processes payloads concurrently" {
    var batch: [JobPayload] = []
    for i in 3 {
        if i == 0 {
            batch.append(JobPayload.Heartbeat)
        } else {
            batch.append(JobPayload.Webhook(url: "https://example.com/{i}", retries: i))
        }
    }

    processed := run_payload_workers(batch)
    assert_eq(processed.len(), 3)
    assert_eq(processed[0]?, "heartbeat")
    assert_eq(processed[1]?, "webhook->https://example.com/1(retries=1)")
    assert_eq(processed[2]?, "webhook->https://example.com/2(retries=2)")
}

error WorkerErr {
    message: String
}

worker BatchCounter(n: Int, ok_out: Chan<Int>) concurrency 2 retry 1 backoff 1ms -> Void | WorkerErr {
    if n < 0 {
        return WorkerErr(message: "negative")
    }
    ok_out.send(n * 10)
}

test "redis_worker declarative worker counts successes and skips permanent errors" {
    ch := Chan<Int>(8)
    out := Chan<Int>(8)
    spawn {
        ch.send(1)
        ch.send(-5)
        ch.send(2)
        ch.close()
    }
    succeeded := BatchCounter(ch, out)
    out.close()

    assert_eq(succeeded, 2)
    var sum = 0
    for v in out {
        sum = sum + v
    }
    assert_eq(sum, 30)
}
