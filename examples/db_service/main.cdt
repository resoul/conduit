import * as db from "cdt.db"
import { text, bool } from "cdt.db"
import * as crypto from "cdt.crypto"
import * as env from "cdt.env"

@db.table("users")
struct User {
    @db.pk @db.auto
    id: Int
    @db.unique @db.index
    email: String
    pw_hash: String
    active: Bool = true
    bio: String?
}

migration 1 "create_users" {
    up { db.create_table<User>()? }
    down { db.drop_table<User>()? }
}

migration 2 "seed_admin" {
    up {
        db.exec(
            "INSERT INTO users (email, pw_hash, active, bio) VALUES (?, ?, ?, ?)",
            [text("admin@example.com"), text("seeded"), bool(true), text("System administrator")],
        )?
    }
    down {
        db.exec("DELETE FROM users WHERE email = ?", [text("admin@example.com")])?
    }
}

export func main() -> Void | db.DbError | crypto.CryptoError | env.EnvError {
    dsn := env.require("DATABASE_URL")?
    conn := db.connect(dsn)?
    applied := conn.migrate()?

    d := conn.dialect()
    print("Connected to {d}, applied {applied} migration(s)")

    pw_hash := crypto.hash_password("hunter2")?
    conn.insert<User>(User(id: 0, email: "alice@example.com", pw_hash: pw_hash, active: true, bio: nil))?

    // Demonstrate transaction rollback
    conn.begin()?
    conn.insert<User>(User(id: 0, email: "temp@example.com", pw_hash: "x", active: false, bio: nil))?
    conn.rollback()?

    users := conn.all<User>()?
    for u in users {
        uid := u.id
        uemail := u.email
        uactive := u.active
        ok := crypto.verify_password("hunter2", u.pw_hash)
        print("user[{uid}] email={uemail} active={uactive} pw_match={ok}")
    }

    conn.close()
}
