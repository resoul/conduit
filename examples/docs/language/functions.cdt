// functions.cdt - Function declarations and first-class functions
func add(a: Int, b: Int) -> Int {
    return a + b
}

func apply_binary(op: (Int, Int) -> Int, x: Int, y: Int) -> Int {
    return op(x, y)
}

func greet(name: String) {
    print("Welcome, " + name)
}

func make_adder(base: Int) -> (Int) -> Int {
    return func(x: Int) -> Int {
        return base + x
    }
}

func main() {
    sum := add(15, 27)
    print(sum)

    // First-class function passing
    res := apply_binary(add, 10, 20)
    print(res)

    greet("Explorer")

    // Anonymous function (lambda) passed inline
    product := apply_binary(func(x: Int, y: Int) -> Int { return x * y }, 6, 7)
    print(product)

    // Lexical closure capturing `base` by value snapshot
    add10 := make_adder(10)
    print(add10(5))
}

