func greet(name: String, formal: Bool) -> String {
    clean_name := name.trim()
    if formal {
        title := clean_name.upper()
        return "Dear " + title
    }
    return "Hi, " + clean_name
}

func is_conduit_file(filename: String) -> Bool {
    return filename.contains(".cdt")
}

func shout(text: String) -> String {
    loud := text.upper()
    return loud + "!!!"
}

func main() {
    g1 := greet("   Alex   ", false)
    print("Greeting 1: {g1}")

    g2 := greet("doctor smith", true)
    print("Greeting 2: {g2}")

    file1 := "main.cdt"
    check1 := is_conduit_file(file1)
    print("Is '{file1}' a conduit file? {check1}")

    file2 := "index.js"
    check2 := is_conduit_file(file2)
    print("Is '{file2}' a conduit file? {check2}")

    msg := shout("welcome to conduit")
    print("Shout: {msg}")
}

