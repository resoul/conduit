func factorial(n: Int) -> Int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

func fibonacci(n: Int) -> Int {
    if n <= 0 {
        return 0
    }
    if n == 1 {
        return 1
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

func max(a: Int, b: Int) -> Int {
    if a > b {
        return a
    }
    return b
}

func is_even(n: Int) -> Bool {
    return n % 2 == 0
}

func clamp(val: Int, low: Int, high: Int) -> Int {
    if val < low {
        return low
    }
    if val > high {
        return high
    }
    return val
}

func main() {
    fact5 := factorial(5)
    print("factorial(5): {fact5}")

    fib7 := fibonacci(7)
    print("fibonacci(7): {fib7}")

    max_val := max(42, 100)
    print("max(42, 100): {max_val}")

    even_check := is_even(14)
    print("is_even(14): {even_check}")

    clamped := clamp(150, 0, 100)
    print("clamp(150, 0, 100): {clamped}")
}

