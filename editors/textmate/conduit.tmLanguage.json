{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Conduit",
  "scopeName": "source.conduit",
  "fileTypes": ["cdt"],
  "patterns": [
    {
      "name": "comment.line.double-slash.conduit",
      "match": "//.*$"
    },
    {
      "name": "meta.annotation.marker.conduit",
      "match": "\\[#[a-zA-Z_][a-zA-Z0-9_]*\\]"
    },
    {
      "name": "entity.other.attribute-name.conduit",
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)?"
    },
    {
      "name": "string.quoted.double.conduit",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.conduit",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.conduit",
      "match": "\\b(func|return|if|else|guard|while|for|in|break|continue|switch|case|var|type|error|export|import|as)\\b"
    },
    {
      "name": "constant.language.boolean.conduit",
      "match": "\\b(true|false)\\b"
    },
    {
      "name": "constant.language.nil.conduit",
      "match": "\\bnil\\b"
    },
    {
      "name": "support.type.conduit",
      "match": "\\b(Int|Float|String|Bool|Void|IndexError|KeyError|ParseError|Map)\\b"
    },
    {
      "name": "support.function.builtin.conduit",
      "match": "\\b(print|map|filter)\\b"
    },
    {
      "name": "constant.numeric.integer.conduit",
      "match": "\\b[0-9]+\\b"
    },
    {
      "name": "entity.name.function.conduit",
      "match": "\\bfunc\\s+([a-zA-Z_][a-zA-Z0-9_]*)"
    },
    {
      "name": "keyword.operator.conduit",
      "match": "(:=|->|\\|>|\\?\\?|==|!=|<=|>=|[+\\-*/=<>?|])"
    }
  ]
}

