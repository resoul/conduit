{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Conduit",
  "scopeName": "source.conduit",
  "fileTypes": ["cdt"],
  "patterns": [
    {
      "name": "comment.line.double-slash.conduit",
      "match": "//.*$"
    },
    {
      "name": "meta.annotation.marker.conduit",
      "match": "\\[#[a-zA-Z_][a-zA-Z0-9_]*\\]"
    },
    {
      "name": "entity.other.attribute-name.conduit",
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)?"
    },
    {
      "name": "string.quoted.double.conduit",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.conduit",
          "match": "\\\\."
        },
        {
          "name": "constant.other.placeholder.conduit",
          "match": "\\{[^}\\n]*\\}"
        }
      ]
    },
    {
      "name": "keyword.control.conduit",
      "match": "\\b(func|return|if|else|guard|while|for|in|break|continue|switch|case|var|struct|type|error|export|import|from|as|cli|group|cmd|flag|opt|arg|rest)\\b"
    },
    {
      "name": "constant.language.boolean.conduit",
      "match": "\\b(true|false)\\b"
    },
    {
      "name": "constant.language.nil.conduit",
      "match": "\\bnil\\b"
    },
    {
      "name": "support.type.conduit",
      "match": "\\b(Int|Float|String|Bool|Void|Map|IndexError|KeyError|ParseError|CliError|EnvError|FsError|Reader|Writer|ProcessError|Output|CryptoError|ValidationError|DecodeError|EncodeError|TimeError|Duration|Instant|Timestamp|Issue)\\b"
    },
    {
      "name": "entity.name.type.conduit",
      "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
    },
    {
      "name": "support.function.builtin.conduit",
      "match": "\\b(print|map|filter|reduce)\\b"
    },
    {
      "name": "constant.numeric.conduit",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    {
      "name": "entity.name.function.conduit",
      "match": "\\bfunc\\s+([a-zA-Z_][a-zA-Z0-9_]*)"
    },
    {
      "name": "entity.name.function.call.conduit",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=[<(])"
    },
    {
      "name": "keyword.operator.conduit",
      "match": "(:=|->|\\|>|\\?\\?|==|!=|<=|>=|[+\\-*/=<>?|])"
    }
  ]
}

