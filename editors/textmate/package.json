{
  "name": "conduit-textmate",
  "displayName": "Conduit TextMate Grammar",
  "description": "TextMate grammar for Conduit .cdt files",
  "version": "0.3.3",
  "publisher": "resoul",
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "engines": {
    "vscode": "*"
  },
  "contributes": {
    "languages": [
      {
        "id": "conduit",
        "aliases": [
          "Conduit",
          "conduit"
        ],
        "extensions": [
          ".cdt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "conduit",
        "scopeName": "source.conduit",
        "path": "./conduit.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Conduit PhpStorm Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/conduit-phpstorm-dark.json"
      }
    ]
  }
}